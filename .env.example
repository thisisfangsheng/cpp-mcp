# 复制为 .env 后填写（.env 已 gitignore，绝不入库、不进镜像）
# 客户端需携带：Authorization: Bearer <此处的值>
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# Ark 图像理解工具；仅调用 analyze_image 时需要
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=doubao-seed-2-1-pro-260628

# 可选：本地测试可设置为 http://127.0.0.1:8888；生产不需要代理时留空。
# 留空时 libcurl 使用 HTTPS_PROXY/https_proxy 等标准代理环境变量。
# 设置 ARK_PROXY=direct 可明确绕过环境代理。
# ARK_PROXY=http://127.0.0.1:8888
# ARK_PROXY=direct

# 可选：有域名并改用公信证书时填写（Caddyfile 中删除 tls internal）
# DOMAIN=example.com
